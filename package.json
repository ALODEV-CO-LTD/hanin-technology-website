{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:seed": "node --disable-warning=ExperimentalWarning --import tsx scripts/seed.ts",
    "db:factory-images": "node --disable-warning=ExperimentalWarning --import tsx scripts/apply-factory-images.ts",
    "db:sync-media": "node --disable-warning=ExperimentalWarning --import tsx scripts/sync-media-library.ts",
    "db:backup": "node --disable-warning=ExperimentalWarning --import tsx scripts/backup.ts",
    "db:create-admin": "node --disable-warning=ExperimentalWarning --import tsx scripts/create-admin.ts",
    "images:scan": "node --import tsx scripts/scan-images.ts",
    "prebuild": "npm run images:scan",
    "db:client-logos": "node --disable-warning=ExperimentalWarning --import tsx scripts/sync-clients.ts",
    "db:knowledge": "node --disable-warning=ExperimentalWarning --import tsx scripts/seed-knowledge-posts.ts",
    "audit:site": "node scripts/audit-site.cjs",
    "db:profile-media": "node --disable-warning=ExperimentalWarning --import tsx scripts/sync-profile-media.ts",
    "db:hanin-images": "node --disable-warning=ExperimentalWarning --import tsx scripts/apply-hanin-images.ts",
    "db:profile-sync": "node --disable-warning=ExperimentalWarning --import tsx scripts/sync-profile-content.ts",
    "db:chot-profile": "node --disable-warning=ExperimentalWarning --import tsx scripts/chot-cms-profile.ts",
    "db:add-en": "node --disable-warning=ExperimentalWarning --import tsx scripts/add-english-db.ts"
  },
  "dependencies": {
    "next": "16.3.7",
    "next-intl": "^4.14.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "subset-font": "^2.9.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "browserslist": [
    "chrome >= 100",
    "edge >= 100",
    "firefox >= 100",
    "safari >= 15.4",
    "ios_saf >= 15.4",
    "samsung >= 18"
  ]
}
